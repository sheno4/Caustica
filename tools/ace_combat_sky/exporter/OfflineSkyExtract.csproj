<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CUE4PARSE_SKIP_NATIVE>true</CUE4PARSE_SKIP_NATIVE>
  </PropertyGroup>
  <Target Name="ValidateCue4ParseSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Cue4ParseSource)' == ''" Text="Set Cue4ParseSource to the local pinned CUE4Parse source checkout." />
    <Error Condition="'$(Cue4ParseSource)' != '' and !Exists('$(Cue4ParseSource)/CUE4Parse/CUE4Parse.csproj')" Text="Cue4ParseSource must contain CUE4Parse/CUE4Parse.csproj." />
  </Target>
  <ItemGroup Condition="'$(Cue4ParseSource)' != ''">
    <ProjectReference Include="$(Cue4ParseSource)/CUE4Parse/CUE4Parse.csproj" AdditionalProperties="CUE4PARSE_SKIP_NATIVE=true" />
  </ItemGroup>
</Project>
