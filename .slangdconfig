{
  "$comment": [
    "Search paths for the Slang language server. Every module resolves as <name>.slang on one of these",
    "roots, so `import foo` and the file foo.slang always correspond. Keep this list in sync with",
    "WorldShaderCompiler's WORLD_MODULES/API_MODULES and each feature's ShaderSource roots — those are",
    "what the compiler actually uses at runtime; this only teaches the editor the same layout."
  ],
  "searchPaths": [
    "src/main/resources/caustica/shaders/api",
    "src/main/resources/caustica/shaders/world",
    "src/main/resources/caustica/shaders/builtin/sky",
    "src/main/resources/caustica/shaders/builtin/surface",
    "src/main/resources/caustica/shaders/builtin/bloom",
    "src/main/resources/caustica/shaders/builtin/common",
    "shaders/common",
    "shaders/pipelines"
  ],
  "predefinedMacros": [],
  "inlayHints": {
    "deducedTypes": true,
    "parameterNames": true
  }
}
